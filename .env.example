# ---------------------------------------------------------------------------
# POLYBOT environment configuration
# Copy this file to .env and fill in your values. Never commit .env.
# ---------------------------------------------------------------------------

# === Operating mode (PAPER = default and recommended until LIVE is approved) ===
POLYBOT_MODE=PAPER

# === User's existing Polymarket wallet (International platform) ===
# Polygon wallet address used for trading (Deposit Wallet / Proxy / Safe / EOA)
POLYMARKET_WALLET_ADDRESS=

# Signer private key for the wallet. Required for LIVE mode only.
# Never commit this file. Kept out of source code per security policy.
POLYMARKET_PRIVATE_KEY=

# === CLOB API credentials (L2 authentication for order placement) ===
# Create these at polymarket.com -> Settings -> API Keys -> Relayer API Keys
POLYMARKET_CLOB_API_KEY=
POLYMARKET_CLOB_API_SECRET=
POLYMARKET_CLOB_API_PASSPHRASE=

# === Optional: Relayer / Builder API keys (for gasless wallet operations) ===
POLYMARKET_RELAYER_API_KEY=
POLYMARKET_RELAYER_API_KEY_ADDRESS=
POLYMARKET_BUILDER_API_KEY=
POLYMARKET_BUILDER_SECRET=
POLYMARKET_BUILDER_PASSPHRASE=

# === Capital configuration (capital must remain unset until configured) ===
# Total pUSD capital allocated to POLYBOT (in pUSD, e.g. 1000)
POLYBOT_CAPITAL_USD=

# === Risk limits ===
POLYBOT_RISK_PER_TRADE=0.02
POLYBOT_DAILY_LOSS_LIMIT=0.04
POLYBOT_MAX_CONSECUTIVE_LOSSES=2
POLYBOT_DAILY_PROFIT_LOCK=

# === Entry strategy ===
POLYBOT_MIN_PROBABILITY=0.60
POLYBOT_MIN_NET_EDGE=0.05
POLYBOT_MAX_SPREAD=0.03
POLYBOT_MAX_SLIPPAGE=0.01
POLYBOT_ENTRY_WINDOW_SECONDS=120

# === Exit strategy (initial research parameters, unvalidated) ===
POLYBOT_TAKE_PROFIT_ROI=0.20
POLYBOT_STOP_LOSS_ROI=0.25

# === Execution ===
POLYBOT_DEFAULT_ORDER_TYPE=FAK
POLYBOT_TAKER_DELAY_MS=250

# === Dashboard ===
POLYBOT_DASHBOARD_HOST=127.0.0.1
POLYBOT_DASHBOARD_PORT=8000
POLYBOT_DASHBOARD_ADMIN_USER=admin
POLYBOT_DASHBOARD_ADMIN_PASSWORD=

# === Data feeds ===
POLYBOT_PRIMARY_FEED=chainlink
POLYBOT_SECONDARY_FEED=chainlink_redundant
POLYBOT_TWAP_FEED=chainlink_twap_60s

# === Heartbeat (never activate during development) ===
POLYBOT_HEARTBEAT_ENABLED=false

# === Logging ===
POLYBOT_LOG_LEVEL=INFO
